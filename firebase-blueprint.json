{
  "entities": {
    "crimes": {
      "title": "Crime Record",
      "description": "Registered crime incident records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "crimeNumber": { "type": "string font-mono" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "crimeType": { "type": "string" },
        "status": { "type": "string" },
        "severity": { "type": "string" },
        "incidentDate": { "type": "string" },
        "location": { "type": "string font-mono" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "assignedOfficer": { "type": "string" },
        "evidenceIds": { "type": "array" },
        "victimIds": { "type": "array" },
        "witnessIds": { "type": "array" },
        "imageUrl": { "type": "string" }
      },
      "required": ["id", "crimeNumber", "title", "crimeType", "status", "severity"]
    },
    "firs": {
      "title": "First Information Report",
      "description": "Formal police FIR filings",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "firNumber": { "type": "string font-mono" },
        "complainantName": { "type": "string" },
        "complainantContact": { "type": "string" },
        "incidentDetails": { "type": "string" },
        "actsAndSections": { "type": "array" },
        "registrationDate": { "type": "string" },
        "policeStation": { "type": "string" },
        "status": { "type": "string" },
        "assignedOfficer": { "type": "string" }
      },
      "required": ["id", "firNumber", "complainantName", "incidentDetails", "status"]
    },
    "criminals": {
      "title": "Criminal Profile",
      "description": "Records of known criminals and suspects",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "legalName": { "type": "string" },
        "aliases": { "type": "array" },
        "codeName": { "type": "string" },
        "dateOfBirth": { "type": "string" },
        "threatLevel": { "type": "string" },
        "photoUrl": { "type": "string" },
        "knownAssociatedGangs": { "type": "array" },
        "fingerprintHash": { "type": "string" },
        "dnaProfileId": { "type": "string" },
        "scarsOrTattoos": { "type": "array" },
        "lastKnownLocation": { "type": "string" },
        "associatedCrimeIds": { "type": "array" },
        "status": { "type": "string" }
      },
      "required": ["id", "legalName", "threatLevel", "status"]
    },
    "evidence": {
      "title": "Evidence Item",
      "description": "Forensic evidence items tracked under chain of custody",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "evidenceTagNumber": { "type": "string font-mono" },
        "crimeId": { "type": "string" },
        "title": { "type": "string" },
        "type": { "type": "string" },
        "collectedBy": { "type": "string" },
        "collectionDate": { "type": "string" },
        "storageLocation": { "type": "string" },
        "isVerifiedIntegrity": { "type": "boolean" },
        "custodyChain": { "type": "array" },
        "imageUrl": { "type": "string" }
      },
      "required": ["id", "evidenceTagNumber", "title", "type"]
    },
    "users": {
      "title": "System User",
      "description": "Police officers and analysts in the system",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "badgeNumber": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "department": { "type": "string" },
        "email": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "securityClearance": { "type": "string" }
      },
      "required": ["id", "badgeNumber", "name", "role"]
    }
